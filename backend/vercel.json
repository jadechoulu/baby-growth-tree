{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].mjs": { "maxDuration": 30, "includeFiles": "{worker,lib,shared,data}/**" }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" }
  ],
  "crons": [ { "path": "/api/cron/auth-cleanup", "schedule": "0 20 * * *" } ]
}
